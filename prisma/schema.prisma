// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 사용자
// ==========================================
model User {
  id               String            @id @default(uuid()) // 사용자 고유 ID (UUID)
  email            String?           @unique // 이메일 (소셜 로그인 시 없을 수 있음)
  passwordHash     String? // bcrypt 해시된 비밀번호 (LOCAL만)
  nickname         String // 표시 닉네임
  provider         AuthProvider // 가입 경로 (LOCAL, GOOGLE 등)
  providerId       String? // 소셜 로그인 시 외부 ID
  role             UserRole          @default(USER) // 권한 (ADMIN/USER)
  refreshTokenHash String? // 리프레시 토큰 해시 (로그아웃 시 null)
  notices          Notice[] // 작성한 공지사항
  hostedRooms      Room[]            @relation("HostedRooms") // 호스트로 만든 방들
  participants     RoomParticipant[] // 참가한 방 기록
  sketchPicStat    SketchPicStat? // 그림 맞추기 통계 (회원 1:1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime? // soft delete 시점
}

// ==========================================
// 공지사항
// ==========================================
model Notice {
  id        String    @id @default(uuid()) // 공지사항 ID
  title     String // 제목
  content   String    @db.Text // 본문 (긴 텍스트)
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String // 작성자 (관리자) ID
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete 시점
}

// ==========================================
// 게임 공통 (방 / 참가자)
// ==========================================

// 게임 방 (모든 게임 공통, 게임 종류는 gameType으로 구분)
model Room {
  id              String            @id @default(uuid()) // 방 ID
  gameType        GameType // 어떤 게임의 방인지 (SKETCH_PIC 등)
  name            String            @db.VarChar(50) // 방 이름 (사용자 표시용)
  status          RoomStatus        @default(WAITING) // WAITING(대기) / IN_GAME(진행)
  maxPlayers      Int               @default(4) // 최대 참가 인원
  isPrivate       Boolean           @default(false) // 비공개 방 여부 (비번 필요)
  password        String?           @db.VarChar(20) // 비공개 방 비밀번호 (평문, 짧음)
  hostUserId      String? // 호스트가 회원이면 User.id
  hostGuestId     String? // 호스트가 게스트면 게스트 UUID
  host            User?             @relation("HostedRooms", fields: [hostUserId], references: [id])
  participants    RoomParticipant[] // 참가자 목록
  sketchPicConfig SketchPicConfig? // 그림 맞추기 방이면 설정 (gameType=SKETCH_PIC)
  whoDrewConfig   WhoDrewConfig? // 그림 마피아 방이면 설정 (gameType=WHO_DREW)
  wordChainConfig WordChainConfig? // 끝말잇기 방이면 설정 (gameType=WORD_CHAIN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([gameType, status]) // 게임별 대기방 목록 조회용
  @@index([createdAt]) // 최신순 정렬용
}

// 방 참가자 (회원/게스트 모두)
model RoomParticipant {
  id       String    @id @default(uuid()) // 참가 기록 ID
  roomId   String // 어느 방인지
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String? // 회원이면 User.id (게스트면 null)
  user     User?     @relation(fields: [userId], references: [id])
  guestId  String?   @db.VarChar(36) // 게스트면 UUID (회원이면 null)
  nickname String    @db.VarChar(20) // 방 안에서 표시될 이름
  isHost   Boolean   @default(false) // 호스트 여부 (방장)
  joinedAt DateTime  @default(now()) // 입장 시각
  leftAt   DateTime? // 퇴장 시각 (null이면 아직 참가 중)

  @@unique([roomId, userId]) // 같은 방에 같은 회원 중복 불가
  @@unique([roomId, guestId]) // 같은 방에 같은 게스트 중복 불가
  @@index([roomId]) // 방별 참가자 조회용
}

// ==========================================
// 그림 맞추기 전용
// ==========================================

// 그림 맞추기 방 설정 (Room 1:1, gameType=SKETCH_PIC 일 때만 존재)
model SketchPicConfig {
  roomId      String @id // Room 1:1 (PK=FK)
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  drawTimeSec Int    @default(60) // 턴별 그림 그리는 시간(초)
}

// 그림 맞추기 단어 사전
model SketchPicWord {
  id        String   @id @default(uuid()) // 단어 ID
  word      String   @unique @db.VarChar(30) // 단어 (중복 불가)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 그림 맞추기 회원별 누적 통계 (게스트는 통계 없음)
model SketchPicStat {
  id           String    @id @default(uuid()) // 통계 row ID
  userId       String    @unique // 회원 1명당 1 row
  user         User      @relation(fields: [userId], references: [id])
  playCount    Int       @default(0) // 플레이한 게임 수
  totalScore   Int       @default(0) // 누적 점수
  drawCount    Int       @default(0) // 그림을 그린 횟수
  correctCount Int       @default(0) // 정답을 맞힌 횟수
  lastPlayedAt DateTime? // 마지막 플레이 시각
  updatedAt    DateTime  @updatedAt
}

// ==========================================
// 그림 마피아 전용 (그림 마피아)
// ==========================================

// 그림 마피아 방 설정 (Room 1:1, gameType=WHO_DREW 일 때만 존재)
model WhoDrewConfig {
  roomId      String @id // Room 1:1 (PK=FK)
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rounds      Int    @default(5) // 각 플레이어가 그리는 횟수(차례 수), 4~8
  turnTimeSec Int    @default(20) // 한 획당 제한 시간(초)
}

// 그림 마피아 단어 쌍 사전 — 일반인 단어 / 마피아 단어(헷갈리는 관련어)
model WhoDrewWordPair {
  id           String   @id @default(uuid()) // 단어쌍 ID
  civilianWord String   @db.VarChar(30) // 일반인이 받는 단어 (예: 사자)
  mafiaWord    String   @db.VarChar(30) // 마피아가 받는 단어 (예: 호랑이)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([civilianWord, mafiaWord]) // 같은 쌍 중복 방지
}

// 끝말잇기 방 설정 (gameType=WORD_CHAIN). 두음법칙은 항상 적용하므로 별도 필드 없음.
model WordChainConfig {
  roomId          String        @id // Room 1:1 (PK=FK)
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  mode            WordChainMode @default(ROUND) // 라운드제 / 토너먼트
  roundCount      Int           @default(3) // 라운드제일 때 라운드 수 (토너먼트면 인원에서 파생, 무시)
  turnTimeSec     Int           @default(15) // 1인당 단어 입력 제한 시간(초)
  allowKillerWord Boolean       @default(false) // 한방단어(끝 글자로 시작하는 단어가 없는 단어) 허용 여부
}

// 끝말잇기 단어 사전 (우리말샘 명사 import). 제출 단어 검증 + 정답 시 뜻 표시용.
model WordChainWord {
  id         Int     @id @default(autoincrement())
  word       String  @unique @db.VarChar(40) // 표제어 (정제된 한글)
  firstChar  String  @db.Char(1) // 첫 글자 (봇/힌트 조회용)
  lastChar   String  @db.Char(1) // 끝 글자
  length     Int // 글자 수
  pos        String  @db.VarChar(10) // 품사 (명사)
  wordType   String? @db.VarChar(10) // 고유어/한자어/외래어
  definition String  @db.Text // 뜻풀이 (정답 시 표시)
  example    String? @db.Text // 예문 (선택)

  @@index([firstChar])
}

// ==========================================
// 문의 / 건의 (1:1 문의)
// ==========================================

// 문의 카테고리 (관리자가 DB에서 관리, 사용자 문의 모달에서 선택)
model InquiryCategory {
  id        String    @id @default(uuid()) // 카테고리 ID
  name      String    @unique @db.VarChar(50) // 카테고리명 (버그 제보, 건의사항 등)
  sortOrder Int       @default(0) // 노출 순서 (오름차순)
  inquiries Inquiry[] // 이 카테고리로 들어온 문의들
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 문의 / 건의 내역 (메일 발송은 운영자가 수동 처리)
model Inquiry {
  id               String          @id @default(uuid()) // 문의 ID
  categoryId       String // 문의 카테고리 ID
  category         InquiryCategory @relation(fields: [categoryId], references: [id]) // 삭제는 기본 Restrict (문의가 있으면 카테고리 삭제 불가)
  email            String?         @db.VarChar(255) // 회신받을 이메일 (보관기간 경과 시 null)
  title            String          @db.VarChar(100) // 제목
  content          String          @db.Text // 내용 (긴 텍스트)
  status           InquiryStatus   @default(PENDING) // 처리 상태
  processedAt      DateTime? // 처리 완료(DONE) 시각 — 보관기간(1년) 기준
  privacyConsent   Boolean         @default(false) // 개인정보 수집·이용 동의 여부 (필수)
  privacyConsentAt DateTime? // 동의 시각
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status]) // 상태별 조회용
  @@index([categoryId]) // 카테고리별 조회용
  @@index([createdAt]) // 최신순 정렬용
}

// ==========================================
// Enum
// ==========================================

// 문의 처리 상태
enum InquiryStatus {
  PENDING // 미처리
  DONE // 처리완료
}

// 게임 종류 (방이 어떤 게임인지 구분)
enum GameType {
  SKETCH_PIC // 그림 맞추기 (그림 맞히기)
  WHO_DREW // 그림 마피아 (그림 마피아)
  WORD_CHAIN // 끝말잇기 (Word Chain)
}

// 끝말잇기 게임 방식
enum WordChainMode {
  ROUND // 라운드제: 정해진 라운드 동안 최다 승 우승
  TOURNAMENT // 토너먼트: 매 라운드 패자 탈락 → 최종 1인 우승
}

// 게임 방 상태
enum RoomStatus {
  WAITING // 입장 대기 중 (게임 끝난 후에도 이 상태로 돌아옴)
  IN_GAME // 게임 진행 중
}

// 사용자 권한
enum UserRole {
  ADMIN // 관리자
  USER // 일반 사용자
}

// 가입 경로
enum AuthProvider {
  GOOGLE // 구글 로그인
  APPLE // 애플 로그인
  KAKAO // 카카오 로그인
  LOCAL // 이메일/비밀번호 로그인
}
