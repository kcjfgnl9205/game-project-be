# 서버 배포 시 .env로 복사해서 사용
#   운영: cp .env.example .env  (COMPOSE_PROJECT_NAME=prod, APP_PORT=3000)
#   개발: cp .env.example .env  (COMPOSE_PROJECT_NAME=dev,  APP_PORT=3001)

# 환경 식별 (prod 또는 dev) — 컨테이너/볼륨 이름 prefix
COMPOSE_PROJECT_NAME=prod

# 외부 포트 (Nginx → 이 포트로 프록시)
# prod: 3000 / dev: 3001
APP_PORT=3000

# MySQL 호스트 노출 포트 (127.0.0.1만 바인딩, SSH 터널 통해 DBeaver 접속용)
# prod: 3306 / dev: 3307
MYSQL_PORT=3306

# CORS 허용 도메인 (콤마로 구분, 공백 없이)
# prod: https://puzmu.com,https://admin.puzmu.com
# dev:  https://dev.puzmu.com,https://dev-admin.puzmu.com,http://localhost:5173
CORS_ORIGINS=https://dev.puzmu.com,https://dev-admin.puzmu.com,http://localhost:5173

# MySQL — 비밀번호는 반드시 변경 (생성: openssl rand -base64 32)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=game_project
MYSQL_USER=nest
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# JWT — 반드시 변경 (생성: openssl rand -base64 64)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 초기 관리자 계정 (첫 seed 실행 시 생성)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NICKNAME=admin
