# 개발(develop 브랜치) 환경 — VM의 ~/game-project-be-dev 에서 사용
#   cp .env.develop.example .env  후 비밀번호/시크릿을 실제 값으로 채울 것
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# 환경 식별 (컨테이너/볼륨 이름 prefix → prod와 격리)
COMPOSE_PROJECT_NAME=dev

# 외부 포트 (Nginx → 이 포트로 프록시). prod(3000)와 겹치지 않게 3001.
APP_PORT=3001

# MySQL 호스트 노출 포트 (127.0.0.1만 바인딩). prod(3306)와 겹치지 않게 3307.
MYSQL_PORT=3307

# 컨테이너 메모리 상한 (개발은 운영보다 작게)
DB_MEM_LIMIT=1500m
APP_MEM_LIMIT=1g

# CORS 허용 도메인 — 개발 프론트/관리자 + 로컬 (콤마 구분, 공백 없이)
CORS_ORIGINS=https://dev.nolmoa.com,https://dev-admin.nolmoa.com,http://localhost:5173

# MySQL — 비밀번호는 반드시 변경.
# ⚠️ DATABASE_URL(mysql://user:pw@host/db)에 박히므로 URL-safe한 영숫자만 사용.
#    생성: openssl rand -hex 24   (base64는 / + = 가 섞여 URL 파싱이 깨짐)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=game_project_dev
MYSQL_USER=nest
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# JWT — 반드시 변경 (생성: openssl rand -base64 64). prod와 다른 값 사용 권장.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
