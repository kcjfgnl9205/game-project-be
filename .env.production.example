# 운영(main 브랜치) 환경 — VM의 ~/game-project-be-prod 에서 사용
#   cp .env.production.example .env  후 비밀번호/시크릿을 실제 값으로 채울 것
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# 환경 식별 (컨테이너/볼륨 이름 prefix → dev와 격리)
COMPOSE_PROJECT_NAME=prod

# 외부 포트 (Nginx → 이 포트로 프록시)
APP_PORT=3000

# MySQL 호스트 노출 포트 (127.0.0.1만 바인딩, SSH 터널로 DBeaver 접속용)
MYSQL_PORT=3306

# 컨테이너 메모리 상한 (VM 24GB 기준 운영에 여유 배분)
DB_MEM_LIMIT=3g
APP_MEM_LIMIT=1g

# CORS 허용 도메인 — 운영 프론트/관리자 (콤마 구분, 공백 없이)
#   ⚠️ https://api.nolmoa.com 은 운영 Swagger(api/docs) 테스트용 임시 허용.
#      관리자 계정 등록 등 끝나면 보안상 제거할 것.
CORS_ORIGINS=https://www.nolmoa.com,https://admin.nolmoa.com,https://api.nolmoa.com

# MySQL — 비밀번호는 반드시 변경.
# ⚠️ DATABASE_URL(mysql://user:pw@host/db)에 박히므로 URL-safe한 영숫자만 사용.
#    생성: openssl rand -hex 24   (base64는 / + = 가 섞여 URL 파싱이 깨짐)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=game_project_prod
MYSQL_USER=nest
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# JWT — 반드시 변경 (생성: openssl rand -base64 64). dev와 다른 값 사용 권장.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
